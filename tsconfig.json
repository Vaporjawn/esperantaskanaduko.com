{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Explicit type packages.
     * When this field is set TypeScript ONLY uses what's listed (no auto-discovery).
     * node       → process.env, NodeJS.Timeout, etc.  (@types/node)
     * jest       → describe / it / expect globals      (@types/jest)
     * @testing-library/jest-dom → toBeInTheDocument etc.
     */
    "types": ["node", "jest", "@testing-library/jest-dom"],

    /* Path aliases — mirror exactly in vite.config.ts and jest.config.cjs */
    "baseUrl": ".",
    "paths": {
      "@/*":           ["src/*"],
      "@contexts/*":   ["src/contexts/*"],
      "@components/*": ["src/components/*"],
      "@frontend/*":   ["src/frontend/*"],
      "@pages/*":      ["src/frontend/pages/*"],
      "@theme/*":      ["src/theme/*"],
      "@hooks/*":      ["src/hooks/*"],
      "@utils/*":      ["src/utils/*"],
      "@i18n/*":       ["src/i18n/*"],
      "@backend/*":    ["src/backend/*"],
      "@esperanto-analyzer": ["packages/esperanto-analyzer/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/*.legacy/**",
    "**/*.old/**",
    "**/*.backup/**"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
