{
  "name": "esperantaskanaduko.com",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Esperanta Skanduko - A comprehensive Esperanto learning and resource website",
  "keywords": [
    "esperanto",
    "language-learning",
    "education",
    "react",
    "typescript",
    "vite",
    "firebase"
  ],
  "author": {
    "name": "Victor Williams",
    "email": "victor.williams.dev@gmail.com",
    "url": "https://github.com/Vaporjawn"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vaporjawn/esperantaskanaduko.com.git"
  },
  "bugs": {
    "url": "https://github.com/Vaporjawn/esperantaskanaduko.com/issues"
  },
  "homepage": "https://esperantaskanaduko.com",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite --host",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:ui": "playwright test --ui",
    "check": "npm install && npm run build && eslint . --ext ts,tsx --max-warnings 0 && jest --coverage",
    "build": "node scripts/generate-sitemap.js && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "generate:og": "node scripts/generate-og-image.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "audit:translations": "node scripts/audit-translations.js",
    "audit:lighthouse": "bash scripts/lighthouse.sh"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@sentry/react": "^10.62.0",
    "@tanstack/react-query": "^5.101.1",
    "firebase": "^12.15.0",
    "gh-pages": "^6.3.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.18.2"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.61.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "babel-jest": "^30.4.1",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
